# Google OAuth client, from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
# generate a value with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Postgres connection string used by the running app.
# Locally: your direct connection string is fine.
# On Vercel (or any serverless host): use Supabase's connection pooler
# string instead (Transaction mode, port 6543, with ?pgbouncer=true) --
# serverless functions can't reach Supabase's direct connection.
DATABASE_URL=

# Postgres connection string used only for migrations (prisma migrate).
# Always the direct connection (port 5432), even on Vercel -- migrations
# aren't run there in this setup, but Prisma still needs this defined.
DIRECT_URL=
